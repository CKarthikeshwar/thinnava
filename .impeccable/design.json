    },
    {
      "name": "Entry Card",
      "kind": "card",
      "refersTo": "card-entry",
      "description": "Timeline card: who, where, loved / didn't like, verdict and price.",
      "html": "<article class=\"ds-card\"><div class=\"ds-top\"><span class=\"ds-av\">A</span><div style=\"flex:1\"><div class=\"ds-who\"><b>Ananya</b> went to</div><div class=\"ds-place\">Bao Story</div><div class=\"ds-meta\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>Indiranagar · with Arjun</div></div><span class=\"ds-time\">2h</span></div><div class=\"ds-lines\"><div>Loved: chicken bao, chilli oil noodles</div><div>Didn&#39;t like: iced tea</div></div><div class=\"ds-foot\"><span class=\"ds-rv\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/><line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/><line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/></svg>Good</span><span class=\"ds-price\">₹450 / person</span></div></article>",
      "css": ":host{--p:#2350D9;--p-strong:#16348F;--on-p:#fff;--pc:#DBE4FF;--on-pc:#0E2266;--bg:#EEF2FF;--surface:#fff;--surface-2:#E6ECFF;--ink:#10183A;--ink-2:#46507A;--ink-3:#5C668C;--line:#D9E0F7;--good:#17703E;--good-bg:#DDF2E4;--ok:#845300;--ok-bg:#FBEFD2;--bad:#A8301F;--bad-bg:#FADFDB;font-family:Nunito,system-ui,sans-serif}.ds-card{width:332px;background:var(--surface);border-radius:20px;padding:14px 14px 13px;box-shadow:0 1px 2px rgba(20,30,50,.05),0 6px 18px -12px rgba(20,30,50,.22);transition:box-shadow .2s}.ds-card:hover{box-shadow:0 1px 2px rgba(20,30,50,.06),0 10px 24px -12px rgba(20,30,50,.3)}.ds-top{display:flex;gap:11px;align-items:flex-start}.ds-av{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:15px;color:#fff;background:#6C8EBF;flex:none}.ds-who{font-size:14px;color:var(--ink-2)}.ds-who b{color:var(--ink);font-weight:800}.ds-place{font-family:Fredoka,system-ui,sans-serif;font-weight:600;font-size:17.5px;color:var(--ink);line-height:1.2}.ds-meta{font-size:12.5px;color:var(--ink-3);font-weight:600;margin-top:2px;display:flex;gap:6px;align-items:center}.ds-time{font-size:12px;font-weight:700;color:var(--ink-3)}.ds-lines{margin:10px 0 0 51px;display:flex;flex-direction:column;gap:5px;font-size:14px;color:var(--ink-2)}.ds-foot{margin:11px 0 0 51px;display:flex;gap:8px;align-items:center}.ds-rv{display:inline-flex;align-items:center;gap:5px;height:26px;padding:0 10px 0 7px;border-radius:999px;font-size:13px;font-weight:800;background:var(--good-bg);color:var(--good)}.ds-price{font-size:13.5px;font-weight:800;color:var(--ink)}"
    },
    {
      "name": "Navigation Bar",
      "kind": "nav",
      "refersTo": "nav-bar",
      "description": "Material 3 bar with pill indicator and centre add button.",
      "html": "<nav class=\"ds-nav\"><a class=\"on\" href=\"#\"><span class=\"ds-pill\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z\"/></svg></span>Home</a><a href=\"#\"><span class=\"ds-pill\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg></span>Search</a><a href=\"#\" aria-label=\"Add\"><span class=\"ds-plus\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></span></a></nav>",
      "css": ":host{--p:#2350D9;--p-strong:#16348F;--on-p:#fff;--pc:#DBE4FF;--on-pc:#0E2266;--bg:#EEF2FF;--surface:#fff;--surface-2:#E6ECFF;--ink:#10183A;--ink-2:#46507A;--ink-3:#5C668C;--line:#D9E0F7;--good:#17703E;--good-bg:#DDF2E4;--ok:#845300;--ok-bg:#FBEFD2;--bad:#A8301F;--bad-bg:#FADFDB;font-family:Nunito,system-ui,sans-serif}.ds-nav{width:300px;height:78px;background:var(--surface);display:flex;justify-content:space-around;align-items:flex-start;padding-top:10px;border-top:1px solid var(--line)}.ds-nav a{display:flex;flex-direction:column;align-items:center;gap:4px;font-size:12px;font-weight:700;color:var(--ink-2);text-decoration:none;width:64px}.ds-pill{width:56px;height:30px;border-radius:16px;display:grid;place-items:center;transition:background .2s}.ds-nav a:hover .ds-pill{background:var(--surface-2)}.ds-nav a:focus-visible{outline:2px solid var(--p);outline-offset:2px;border-radius:12px}.ds-nav a.on{color:var(--ink)}.ds-nav a.on .ds-pill{background:var(--pc);color:var(--on-pc)}.ds-plus{width:52px;height:52px;border-radius:18px;background:var(--p);color:#fff;display:grid;place-items:center;margin-top:-4px;box-shadow:0 6px 14px -6px var(--p)}"
    },
    {
