# Build switches for production web builds (spec §18.3). No secrets here: the real values come from Cloudflare.
# Removes unused code (e.g. the ~1,500 icons we don't use) from the website bundle.
EXPO_UNSTABLE_TREE_SHAKING=1
EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1

# Production builds (release APK, website) talk to the production backend. These values are public by design
# (publishable key, OAuth client ID). Local `.env` (sandbox) is used for development only.
APP_ENV=prod
EXPO_PUBLIC_SUPABASE_URL=https://vfkxwxhocelfvlpsqtwc.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_rogaSayh_xWoxaU_8J4iQQ_hQjfYjdx
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1062640067839-stmra6machv6emfj837ui0pe6im3nenl.apps.googleusercontent.com
