# Copy to .env and fill in. Never commit .env. See spec.md §27.3.
APP_ENV=dev
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Build-time only (Maps SDK for Android, restricted key from the thinnava-maps project)
GOOGLE_MAPS_ANDROID_KEY=
# Push (spec §26.9): Expo project id (free Expo account). Put google-services.json (Firebase project thinnava-f44c7, Spark plan) in app/.
EAS_PROJECT_ID=
